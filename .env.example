# Copy this file to .env (or export these as real environment variables on your server)
# and fill in real values before deploying publicly.
# server.js loads this file automatically at startup (Node's built-in
# process.loadEnvFile(), no extra dependency needed) — just place a real
# .env next to server.js and restart the app (e.g. `pm2 restart`).

# A long random secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-secret

# Port the server listens on
PORT=3000

# --- Security checklist settings (see README) ---
# Leave these OFF (default) for local testing or an internal-LAN server with
# no reverse proxy. Turn them ON only once the app is deployed on a public
# VPS behind Nginx with HTTPS — turning them on without a real reverse proxy
# in front will break login (secure cookies need real HTTPS; trust proxy
# without a real proxy lets a client spoof its own IP).

# Bind Node to localhost only, so it's unreachable except through Nginx.
# For an internal-LAN deployment (no Nginx), leave this unset (defaults to 0.0.0.0).
HOST=127.0.0.1

# Set to true only when Nginx is terminating HTTPS and proxying to this app.
TRUST_PROXY=false

# Set to true only once the site is actually served over HTTPS.
FORCE_SECURE_COOKIE=false
